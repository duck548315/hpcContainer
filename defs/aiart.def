BootStrap: docker
From: nvidia/cuda:12.1.1-devel-ubuntu22.04

%post
    # Install essential system tools
    apt-get update && apt-get install -y \
    git curl wget build-essential ninja-build \
    python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

    # Install 'uv' for lightning-fast Python package management
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Fix git ownership warning
    git config --global --add safe.directory '*'

    # Add this line to confirm uv is found
    uv --version

    # After installing uv, install Python packages via uv
    # Note: remove 'logging' — it's Python stdlib, not a pip package
    uv pip install --system \
    torch==2.4.0 torchvision==0.19.0 \
    --index-url https://download.pytorch.org/whl/cu121

    uv pip install --system \
    braceexpand filelock fsspec Jinja2 MarkupSafe \
    mpmath networkx numpy pillow PyYAML sympy \
    tqdm triton typing_extensions webdataset \
    matplotlib plyfile>=0.7.4 pot lapjv \
    ftfy regex python-dotenv wandb \
    git+https://github.com/openai/CLIP.git tyro

%environment
    export PATH="/root/.local/bin:$PATH"

%runscript
    echo "This container can make you run the AIArt project."
    exec "$@"